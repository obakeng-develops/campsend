<%# One audit row. The delivery page omits the target, because the page is the
    target, and drops the year, because everything on it is recent. %>
<li class="<%= "activity-item--denied" if event.denied? %>">
  <div class="activity-item__line">
    <strong><%= event.description %></strong>
    <% if event.denied? %><span class="activity-denied">Refused</span><% end %>
  </div>
  <p class="activity-item__who"><%= event.actor_description %><%= " · #{event.target_label}" if show_target && event.target_label.present? %></p>
  <% if event.changed_fields.present? %>
    <p class="activity-item__diff">
      <% event.changed_fields.each do |field, (before, after)| %>
        <span><%= field.humanize %>: <%= before.presence || "none" %> → <%= after.presence || "none" %></span>
      <% end %>
    </p>
  <% end %>
  <time datetime="<%= event.occurred_at.iso8601 %>"><%= event.occurred_at.strftime(date_format) %></time>
</li>
