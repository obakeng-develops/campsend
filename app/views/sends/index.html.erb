<% content_for :title, "Sent · Campsend" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">Sent</p>
    <h1>Your deliveries</h1>
  </div>
  <%= link_to new_send_path, class: "button button--primary" do %>
    <span aria-hidden="true">＋</span> Send files
  <% end %>
</div>

<% if @sends.any? %>
  <div class="send-stream">
    <% @sends.each do |delivery| %>
      <% primary_file = delivery.files.first %>
      <%= link_to send_path(delivery), class: "send-card" do %>
        <%= render layout: "shared/delivery_summary", locals: { delivery:, primary_file:, preview_url: send_file_path(delivery, primary_file) } do %>
          <div class="relationship-row">
            <span class="avatar" aria-hidden="true"><%= delivery.recipient_name.first %></span>
            <span><%= status_sentence(delivery) %></span>
            <% if delivery.access_active? %><span class="delivery-expiry">Until <%= delivery.access_expires_at.strftime("%b %-d") %></span><% end %>
            <span class="status-dot status-dot--<%= delivery.display_status %>" aria-hidden="true"></span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <section class="empty-state">
    <div class="empty-file" aria-hidden="true">
      <span class="empty-file__fold"></span>
      <span class="empty-file__line"></span>
      <span class="empty-file__line empty-file__line--short"></span>
    </div>
    <h2>No deliveries yet.</h2>
    <p>Choose files, enter a recipient, and add an optional note.</p>
    <%= link_to "Send files", new_send_path, class: "button button--primary" %>
  </section>
<% end %>
