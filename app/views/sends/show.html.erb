<% content_for :title, "Delivery to #{@send.recipient_name} · Campsend" %>
<% content_for :head do %><meta http-equiv="refresh" content="3;url=<%= send_path(@send) %>"><% end if @send.email_status_pending? && !@send.scheduled? %>

<% if @first_delivery_complete %>
  <section class="first-delivery-complete" role="status">
    <span class="first-delivery-complete__mark" aria-hidden="true">✓</span>
    <div>
      <p class="eyebrow">First delivery</p>
      <h1><%= @send.scheduled? ? "Your delivery is scheduled." : "Your delivery is on its way." %></h1>
      <p><%= @send.scheduled? ? "We’ll email #{@send.recipient_email} at the scheduled time. Their link will stay active for 30 days." : "We’re emailing #{@send.recipient_email} now. Their link will stay active for 30 days." %></p>
      <div class="first-delivery-complete__actions">
        <%= link_to "View delivery", "#delivery-details", class: "button button--primary" %>
        <%= link_to "Send another", new_send_path, class: "button" %>
        <%= link_to "Go to My Files", files_path, class: "button button--quiet" %>
      </div>
    </div>
  </section>
<% end %>

<div class="detail-heading">
  <%= link_to sends_path, class: "back-link" do %><span aria-hidden="true">←</span> Sent<% end %>
  <% status = @send.display_status %>
  <span class="status-pill status-pill--<%= status %>"><%= status.titleize %></span>
</div>

<section class="send-detail" id="delivery-details">
  <div class="detail-files <%= "detail-files--grid" if @send.files.size > 1 %>">
    <% @send.files.each do |file| %>
      <div class="detail-file">
        <% if previewable_image?(file) %>
          <%= image_tag send_file_path(@send, file), alt: file.filename.to_s %>
        <% else %>
          <div class="file-glyph file-glyph--large"><span><%= file_kind(file) %></span></div>
        <% end %>
        <div class="file-meta">
          <strong><%= file.filename %></strong>
          <span><%= number_to_human_size(file.byte_size) %></span>
        </div>
        <% unless @send.canceled? || @send.collection_id? %>
          <%= form_with url: send_revisions_path(@send), scope: :revision, class: "file-replacement" do |form| %>
            <%= form.hidden_field :attachment_id, value: file.id %>
            <%= form.file_field :file, direct_upload: true, required: true, aria: { label: "Replacement for #{file.filename}" } %>
            <%= form.submit "Replace file", class: "button button--primary" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="detail-context">
    <div class="recipient-line">
      <span class="avatar avatar--large" aria-hidden="true"><%= @send.recipient_name.first %></span>
      <div><span>Sent to</span><strong><%= @send.recipient_email %></strong></div>
    </div>
    <% if @send.latest_revision.collection_name.present? %>
      <p class="access-summary">Collection: <strong><%= @send.latest_revision.collection_name %></strong><% if @send.collection && !@send.collection.removed_at? %> · <%= link_to "Manage collection", @send.collection %><% end %></p>
    <% end %>
    <% if @send.scheduled? %>
      <p class="schedule-summary">Scheduled for <time datetime="<%= @send.scheduled_at.iso8601 %>" data-controller="local-time"><%= @send.scheduled_at.to_fs(:long) %> UTC</time>.</p>
    <% elsif @send.canceled? %>
      <p class="schedule-summary">Canceled before publication.</p>
    <% end %>
    <% if @send.access_expires_at || @send.access_revoked_at? %>
      <p class="access-summary">
        <% if @send.access_revoked_at? %>
          Access revoked <%= time_ago_in_words(@send.access_revoked_at) %> ago.
        <% elsif @send.access_expires_at.past? %>
          Access expired on <%= @send.access_expires_at.strftime("%b %-d, %Y") %>.
        <% else %>
          Recipient access expires on <%= @send.access_expires_at.strftime("%b %-d, %Y") %>.
        <% end %>
      </p>
    <% end %>
    <% if @send.slug.present? %>
      <p class="access-summary">Delivery path: <strong>/d/<%= @send.slug %></strong></p>
    <% end %>
    <% if @send.message.present? %><blockquote>“<%= @send.message %>”</blockquote><% end %>

    <ol class="event-ledger" aria-label="Delivery activity">
      <% %w[sent opened downloaded].each do |event_type| %>
        <% event = @send.send_events.find { |item| item.event_type == event_type } %>
        <li class="<%= "event-ledger__done" if event %>">
          <span class="event-marker" aria-hidden="true"></span>
          <strong><%= event_type.titleize %></strong>
          <span><%= event ? event.occurred_at.strftime("%b %-d at %-I:%M %p") : (event_type == "sent" && @send.email_status_failed? ? "Email failed" : "Not #{event_type} yet") %></span>
        </li>
      <% end %>
    </ol>
    <div class="access-actions">
      <% if @send.scheduled? %>
        <%= link_to "Edit schedule", edit_send_path(@send), class: "button" %>
        <%= button_to "Cancel delivery", cancel_send_path(@send), class: "button button--quiet", form: { data: { turbo_confirm: "Cancel this scheduled delivery?" } } %>
      <% elsif @send.canceled? %>
        <span class="fine-print">This delivery will not be published.</span>
      <% elsif @send.email_status_pending? %>
        <span class="fine-print">Emailing the delivery link now.</span>
      <% elsif @send.email_status_failed? %>
        <span class="fine-print">The delivery email could not be sent.</span>
        <% if @send.access_revoked_at? || @send.access_expires_at&.past? %>
          <%= button_to "Restore access and try again", rotate_access_send_path(@send), class: "button", form: { data: { turbo_confirm: "Restore recipient access and email a new link?" } } %>
        <% else %>
          <%= button_to "Try emailing again", rotate_access_send_path(@send), class: "button" %>
        <% end %>
      <% else %>
        <% if @send.access_active? %>
          <%= button_to "Revoke recipient access", revoke_access_send_path(@send), class: "button button--quiet" %>
          <%= button_to "Replace link and email recipient", rotate_access_send_path(@send), class: "button", form: { data: { turbo_confirm: "Replace the current link? The previous link will stop working." } } %>
        <% else %>
          <span class="fine-print">Recipient access is inactive.</span>
          <%= button_to "Restore access and email a new link", rotate_access_send_path(@send), class: "button", form: { data: { turbo_confirm: "Restore recipient access and email a new link?" } } %>
        <% end %>
      <% end %>
      <% if @send.published? && @send.slug.blank? %>
        <%= button_to "Delete delivery", send_path(@send), method: :delete, class: "button button--quiet", form: { data: { turbo_confirm: "Delete this delivery and its activity? Files kept in My Files will remain." } } %>
      <% elsif @send.published? && @send.slug.present? %>
        <span class="fine-print">Published delivery paths cannot be deleted or reused.</span>
      <% end %>
    </div>
  </div>
</section>

<% if @audit_events.any? %>
  <section class="delivery-history" aria-labelledby="delivery-history-title">
    <h2 id="delivery-history-title">History</h2>
    <ol class="activity-list">
      <%= render partial: "shared/activity_event", collection: @audit_events, as: :event,
            locals: { show_target: false, date_format: "%b %-d at %-I:%M %p" } %>
    </ol>
  </section>
<% end %>

<% Rails.configuration.x.sender_delivery_partials.each do |partial| %>
  <%= render partial, delivery: @send %>
<% end %>

<% if @revisions.many? %>
  <section class="revision-history" aria-labelledby="revision-history-title">
    <div class="revision-history__heading">
      <p class="eyebrow">Delivery history</p>
      <h2 id="revision-history-title">Previous versions</h2>
    </div>
    <ol>
      <% @revisions.each do |revision| %>
        <li>
          <div>
            <strong>Version <%= revision.number %><%= " · #{revision.collection_name}" if revision.collection_name.present? %></strong>
            <time datetime="<%= revision.created_at.iso8601 %>"><%= revision.created_at.strftime("%b %-d, %Y at %-I:%M %p") %></time>
          </div>
          <ul>
            <% revision.files.each do |file| %>
              <li><%= link_to file.filename, send_file_path(@send, file) %> <span><%= number_to_human_size(file.byte_size) %></span></li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
