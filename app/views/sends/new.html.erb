<% content_for :title, "Send files · Campsend" %>

<div class="compose-heading">
  <%= link_to files_path, class: "back-link" do %><span aria-hidden="true">←</span> Back to My Files<% end %>
  <div>
    <p class="eyebrow"><%= @first_delivery ? "Your first delivery" : "New delivery" %></p>
    <h1><%= @collection ? "Send #{@collection.name}." : "Choose what to send." %></h1>
    <% if @first_delivery %><p class="compose-intro">Choose your files, add a recipient, and send. We’ll save the files in My Files so you can reuse them later.</p><% end %>
  </div>
</div>

<%= form_with model: @send, class: "send-form", data: { controller: "file-drop upload-progress schedule upload", action: "submit->schedule#sync submit->upload#submit direct-upload:start->upload-progress#start direct-upload:progress->upload-progress#updateProgress direct-upload:end->upload-progress#end direct-upload:error->upload-progress#error", schedule_utc_value: @send.scheduled_at&.iso8601, upload_progress_final_text_value: "Creating delivery…" } do |form| %>
  <% if @send.errors.any? %>
    <div class="form-errors" role="alert">
      <strong>We couldn’t create this delivery:</strong>
      <%= @send.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div class="form-errors" role="alert" data-upload-progress-target="error" hidden></div>

  <div class="send-files-column">
    <% if @collection %>
      <%= form.hidden_field :collection_id, value: @collection.id %>
      <section class="selected-collection">
        <p class="eyebrow">Collection</p>
        <h2><%= @collection.name %></h2>
        <span><%= pluralize(@collection.blobs.size, "file") %> · <%= number_to_human_size(@collection.size_bytes) %></span>
        <ul>
          <% @collection.blobs.each do |blob| %><li><%= blob.filename %></li><% end %>
        </ul>
        <%= link_to "Choose separate files", new_send_path, class: "button button--quiet" %>
      </section>
    <% else %>
      <% if @collections.any? %>
        <section class="compose-collections">
          <div class="compose-collections__heading">
            <strong>Send a collection</strong>
            <%= link_to "Manage collections", collections_path %>
          </div>
          <div class="collection-list">
            <% @collections.each do |collection| %>
              <%= link_to new_send_path(collection_id: collection.id), class: "collection-card collection-card--compact" do %>
                <div>
                  <strong><%= collection.name %></strong>
                  <span><%= pluralize(collection.blobs.size, "file") %> · <%= number_to_human_size(collection.size_bytes) %></span>
                </div>
                <span aria-hidden="true">→</span>
              <% end %>
            <% end %>
          </div>
        </section>
        <p class="send-source-label">Or send separate files</p>
      <% end %>
      <div class="drop-zone" role="button" tabindex="0" aria-label="Choose files to send" data-file-drop-target="zone" data-action="dragover->file-drop#dragOver dragleave->file-drop#dragLeave drop->file-drop#drop click->file-drop#choose keydown.enter->file-drop#choose keydown.space->file-drop#choose">
        <%= form.file_field :files, multiple: true, class: "visually-hidden", data: { file_drop_target: "input", upload_target: "input", upload_url: rails_direct_uploads_path, action: "change->file-drop#changed" } %>
        <div class="drop-prompt" data-file-drop-target="prompt">
          <div class="drop-icon" aria-hidden="true">↑</div>
          <strong>Drop files here</strong>
          <span>or choose from your computer</span>
          <small>Any file type. Up to <%= Send::MAX_FILES %> files, <%= Send.human_max_size_for(current_user) %> per delivery.</small>
          <% if (storage = Campsend.policy.storage_usage_for(current_user)) %>
            <small>Storage: <%= number_to_human_size(storage[:used]) %> of <%= number_to_human_size(storage[:limit]) %> used. Sent files stay in My Files.</small>
          <% end %>
        </div>
        <div class="selected-state" data-file-drop-target="state" hidden>
          <div class="selected-files" data-file-drop-target="list" aria-live="polite"></div>
          <button type="button" class="change-files" data-file-drop-target="change" data-action="file-drop#choose">Choose different files</button>
        </div>
      </div>

      <% if @library_files.any? %>
        <fieldset class="library-picker">
          <legend class="visually-hidden">Recent files from My Files</legend>
          <div class="library-picker__heading"><span>Recent files from My Files</span><%= link_to "View all My Files", files_path %></div>
          <div>
            <% @library_files.each do |file| %>
              <%= check_box_tag "send[files][]", file.blob.signed_id, file.id == @selected_file_id, id: "library_file_#{file.id}" %>
              <%= label_tag "library_file_#{file.id}" do %>
                <span class="library-picker__file-icon"><%= file_kind(file.blob) %></span>
                <span><strong><%= file.filename %></strong><small><%= number_to_human_size(file.byte_size) %></small></span>
              <% end %>
            <% end %>
          </div>
        </fieldset>
      <% end %>
    <% end %>
  </div>

  <div class="send-details">
    <% if @first_delivery %><p class="eyebrow">Recipient and access</p><% end %>
    <div class="field">
      <%= form.label :recipient_email, "Who’s this for?" %>
      <%= form.email_field :recipient_email, required: true, autocomplete: "email", placeholder: "sam@example.com" %>
    </div>
    <div class="field">
      <%= form.label :slug, "Delivery link" %>
      <%= form.text_field :slug, maxlength: 100, placeholder: "project-update", autocapitalize: "none", spellcheck: false %>
      <small>Optional. Use lowercase letters, numbers, and hyphens. This is visible to recipients and cannot change after sending.</small>
    </div>
    <div class="field">
      <div class="label-row">
        <%= form.label :message, "Add a note" %>
        <span>Optional</span>
      </div>
      <%= form.text_area :message, rows: 3, maxlength: 500, placeholder: "Add context for the recipient" %>
    </div>
    <%= render "schedule_fields", form: form %>
    <%= form.submit @collection ? "Send collection" : "Send files", class: "button button--primary button--wide button--send", data: { upload_progress_target: "submit" } %>
    <p class="upload-status" role="status" aria-live="polite" data-upload-progress-target="status" hidden></p>
    <p class="privacy-note"><span aria-hidden="true">⌁</span> The link expires after 30 days. Anyone with the full link can open it.</p>
  </div>
<% end %>
