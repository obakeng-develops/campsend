<% content_for :title, "Sign in · Campsend" %>

<section class="auth-card">
  <div class="auth-brand">
    <%= render "shared/wordmark", large: true %>
  </div>
  <% flash.each do |type, message| %>
    <div class="auth-feedback auth-feedback--<%= type %>" role="<%= type.to_s == "alert" ? "alert" : "status" %>">
      <span class="auth-feedback__marker" aria-hidden="true"></span>
      <span><%= message %></span>
    </div>
  <% end %>
  <% if @sign_in_email %>
    <div class="auth-copy">
      <h1>Check your inbox.</h1>
      <p>We emailed a sign-in link to <strong><%= @sign_in_email %></strong>. It expires in 15 minutes.<%= " Open it to continue your delivery." if @sign_in_intent == "send" %></p>
    </div>
    <%= link_to "Use another email", new_session_path(intent: @sign_in_intent, return_to: params[:return_to], change_email: 1), class: "button button--wide" %>
  <% else %>
    <div class="auth-copy">
      <h1><%= @sign_in_intent == "send" ? "Start your delivery." : "Sign in or start free." %></h1>
      <p><%= @sign_in_intent == "send" ? "Enter your email address. We’ll send a sign-in link, then bring you straight to your delivery." : "Enter your email address. If you’re new, we’ll create your Free account. No password needed." %></p>
    </div>

    <%= form_with url: session_path, class: "auth-form" do |form| %>
      <%= hidden_field_tag :intent, params[:intent] if params[:intent].present? %>
      <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
      <div class="field">
        <%= form.label :email_address, "Email address" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
      </div>
      <%= form.submit "Email me a sign-in link", class: "button button--primary button--wide" %>
    <% end %>
  <% end %>
</section>
