<% content_for :title, "Sign in blocked · Campsend" %>

<section class="auth-card">
  <div class="auth-brand">
    <%= render "shared/wordmark", large: true %>
  </div>
  <div class="auth-copy">
    <h1>Your browser blocked the sign-in.</h1>
    <p>It did not send back the cookie this page needs, so nothing happened and your link still works.</p>
    <p>Allow cookies for campsend.app, or turn off an extension that blocks them, then open the link from your email again. Opening it in another browser also works.</p>
  </div>
</section>
