<% content_for :title, "Shared with me · Campsend" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">Incoming</p>
    <h1>Shared with me</h1>
  </div>
</div>

<% if @sends.any? %>
  <div class="send-stream">
    <% @sends.each do |delivery| %>
      <% primary_file = delivery.files.first %>
      <%= link_to delivery_path(public_id: delivery.delivery_identifier), class: "send-card" do %>
        <%= render layout: "shared/delivery_summary", locals: { delivery:, primary_file:, preview_url: delivery_file_path(public_id: delivery.delivery_identifier, id: primary_file.id) } do %>
          <div class="relationship-row">
            <span class="avatar" aria-hidden="true"><%= delivery.user.email_address.first %></span>
            <span>From <%= delivery.user.email_address %></span>
            <span class="delivery-expiry">Until <%= delivery.access_expires_at.strftime("%b %-d") %></span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <section class="empty-state">
    <div class="empty-file" aria-hidden="true">
      <span class="empty-file__fold"></span>
      <span class="empty-file__line"></span>
      <span class="empty-file__line empty-file__line--short"></span>
    </div>
    <h2>No files shared with you.</h2>
    <p>Active deliveries sent to <%= current_user.email_address %> will appear here.</p>
  </section>
<% end %>
