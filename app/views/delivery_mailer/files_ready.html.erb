<h1>Your <%= @file_count == 1 ? "file is" : "#{@file_count} files are" %> ready</h1>
<p><%= @sender %> sent <%= @file_count == 1 ? "it" : "them" %> to you.</p>
<% if @send.message.present? %>
  <p>“<%= @send.message %>”</p>
<% end %>
<p><%= link_to @file_count == 1 ? "View file" : "View files", delivery_url(public_id: @send.delivery_identifier, anchor: "token=#{@access_token}") %></p>
<p>This delivery was sent to <%= @send.recipient_email %>. Forwarding the full link shares access.</p>
